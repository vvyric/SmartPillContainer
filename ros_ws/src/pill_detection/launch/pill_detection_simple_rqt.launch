<launch>
  <!-- Parameters for the simulation node -->
  <arg name="imu_file" default="$(find pill_detection)/data/data_IMU.txt" />
  <arg name="pl_file" default="$(find pill_detection)/data/data_press_light.txt" />
  <arg name="log_dir" default="$(find pill_detection)/logs" />
  <arg name="playback_speed" default="0.5" /> <!-- Slower playback for more reliable detection -->
  <arg name="force_events" default="true" /> <!-- Force pill events for testing -->
  
  <!-- Launch the simulation node -->
  <node name="pill_detection_simulation" pkg="pill_detection" type="pill_detection_simulation_node.py" output="screen">
    <param name="imu_file" value="$(arg imu_file)" />
    <param name="pl_file" value="$(arg pl_file)" />
    <param name="log_dir" value="$(arg log_dir)" />
    <param name="playback_speed" value="$(arg playback_speed)" />
    <param name="force_events" value="$(arg force_events)" />
    
    <!-- Override default thresholds for better event detection -->
    <param name="motion_threshold" value="0.03" />
    <param name="tilt_threshold" value="5.0" />
    <param name="pressure_threshold" value="50.0" />
    <param name="light_threshold" value="15.0" />
    
    <!-- Enable debug output -->
    <param name="debug_level" value="info" />
  </node>
  
  <!-- Launch four separate rqt_plot instances for different data groups -->
  <!-- Wait a few seconds for the node to start publishing data -->
  
  <!-- Basic acceleration and motion state -->
  <node name="rqt_accel" pkg="rqt_plot" type="rqt_plot" 
        args="/pill_detection/accel_magnitude/x /pill_detection/accel_magnitude/y /pill_detection/motion_state/x" 
        launch-prefix="bash -c 'sleep 3; $0 $@'" />
  
  <!-- Sensor data: pressure and light -->
  <node name="rqt_sensors" pkg="rqt_plot" type="rqt_plot" 
        args="/pill_detection/pressure_light/pressure /pill_detection/pressure_light/light" 
        launch-prefix="bash -c 'sleep 4; $0 $@'" />
  
  <!-- Event counters -->
  <node name="rqt_events" pkg="rqt_plot" type="rqt_plot" 
        args="/pill_detection/event_status/x /pill_detection/event_status/y /pill_detection/event_status/z" 
        launch-prefix="bash -c 'sleep 5; $0 $@'" />
  
  <!-- Thresholds -->
  <node name="rqt_thresholds" pkg="rqt_plot" type="rqt_plot" 
        args="/pill_detection/thresholds/x /pill_detection/thresholds/y /pill_detection/thresholds/z" 
        launch-prefix="bash -c 'sleep 6; $0 $@'" />
</launch>